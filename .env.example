# Supabase (frontend-safe publishable/anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI providers (server-side only; never use VITE_ prefix)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional model-chain overrides. Example:
# AI_SIMPLE_MODELS=openrouter:openrouter/free,gemini:gemini-2.5-flash-lite,groq:llama-3.1-8b-instant
# AI_MEDIUM_MODELS=openrouter:openrouter/free,gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile
# AI_COMPLEX_MODELS=openrouter:openrouter/free,gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile

AI_MAX_RETRIES=2
AI_BASE_DELAY_MS=700
AI_MAX_DELAY_MS=6000
AI_TIMEOUT_MS=60000
AI_CB_FAILURE_THRESHOLD=3
AI_CB_COOLDOWN_MS=30000
