# Buildora is connected to Nexus_ai using the public configuration in server/cloud-config.js.
# Set local explicitly only for offline SQLite accounts.
AUTH_PROVIDER=supabase
BUILDORA_DATA_DIR=.buildora
COOKIE_SECURE=false
ALLOW_LOCAL_GUEST=false

# Add your real domain when deploying, then rebuild.
SITE_URL=https://buildora.farhanbalouch.com
VITE_SITE_URL=https://buildora.farhanbalouch.com

# Free routes only: paid provider fallback is disabled by default.
AI_FREE_ONLY=true
OPENROUTER_API_KEY=
# Alternative: install Ollama and a model yourself, then enter its exact name.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Supabase mode; public publishable key only, never service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional providers; only used if you explicitly set AI_FREE_ONLY=false.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Public browser integration key, if issued by WebContainer vendor.
VITE_WEBCONTAINER_API_KEY=
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000

# Optional hosted guest generation using the server provider (rate-limited).
ALLOW_GUEST_AI=false
# Custom BYOK endpoints: comma-separated exact HTTPS hostnames you trust.
AI_ALLOWED_HOSTS=
